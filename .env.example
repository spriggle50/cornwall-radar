# Copy this file to .env and fill in your own values.
# Nothing in this project will run against real traffic/bus data without these.

PORT=3000

# TomTom Traffic API — free tier signup: https://developer.tomtom.com/
TOMTOM_API_KEY=

# Bus Open Data Service (BODS) — free registration: https://data.bus-data.dft.gov.uk/
BODS_API_KEY=

# National Highways Roads API (trunk road closures) — free registration:
# https://developer.nationalhighways.co.uk/ — optional, adds A30/A38/A39/A390
# closures alongside TomTom's incidents. Traffic still works with just TomTom.
NATIONAL_HIGHWAYS_API_KEY=

# Google Maps Platform key (console.cloud.google.com) with the Pollen API and
# Weather API enabled — needs billing turned on, unlike every other source in
# this project. Powers the separate "Weather Details" page (pollen counts +
# extra current-conditions stats). Leave blank and that page just says it's
# not set up yet — nothing else on the site depends on this key.
GOOGLE_MAPS_API_KEY=

# Ticketmaster Discovery API — free developer account: https://developer.ticketmaster.com/
# Adds ticketed local events (gigs, shows, sport) to the Events & What's On page.
# (Eventbrite was tried too but Eventbrite permanently shut off public event
# search for standard API keys in 2020 — no working key can fix that, so it's
# not part of this project. The Cornwall Live "What's On" feed on that same
# page needs no key at all — it's always on, free and keyless.)
TICKETMASTER_API_KEY=

# Rail Data Marketplace (https://raildata.org.uk) subscription key — free
# registration. Powers the Train Times page (live departures for the
# nearest Cornwall station, called directly via RDM's own REST gateway).
# Leave blank and Train Times still works, just via a free public relay
# (national-rail-api.davwheat.dev) that already has its own token built
# in — handy to get started with, but it's a volunteer-run service with no
# uptime guarantee, so setting your own key here is the more reliable option.
RAILDATA_API_KEY=

# Storm Overflows (South West Water's live discharge map) needs no key at
# all — it's a public ArcGIS feed, always on, free and keyless.

# ── Phase 1.5: accounts, billing, and the morning-digest alert ─────────────
# The free dashboard above works with none of this set. Everything below is
# only needed once you're ready to turn on sign-in and the paid tier.

# Your OWN base URL once deployed (used to build Stripe redirect links and
# the "open Cornwall Radar" link in digest emails). Locally this can stay as
# the default in billing.js/morningDigest.js — only needs setting in
# production.
APP_BASE_URL=https://cornwallradar.co.uk

# Supabase — create a NEW project at https://supabase.com/dashboard
# (separate from Spriggle's, per Cornwall-Radar-Spec.md §3), then run the
# whole of schema.sql in its SQL Editor. Project Settings → API has all
# three values below.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — https://dashboard.stripe.com (test mode to start). Create one
# recurring Price (the spec suggests ~£9.99/year) and use its price ID
# below; the secret/publishable keys are under Developers → API keys.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# Developers → Webhooks → add an endpoint pointing at
# https://cornwallradar.co.uk/api/billing/webhook, subscribed to at least:
# checkout.session.completed, customer.subscription.updated,
# customer.subscription.deleted, invoice.payment_failed. Stripe shows the
# signing secret once the endpoint is created.
STRIPE_WEBHOOK_SECRET=

# Resend — https://resend.com, free tier (100 emails/day). Sends the
# morning digest. Verify your own sending domain there before going live,
# or emails will land from Resend's shared test domain instead.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Cornwall Radar <digest@cornwallradar.co.uk>

# A password you make up yourself — anything long and random. Required
# before GET /api/cron/morning-digest will run at all, since that endpoint
# sends real email to real subscribers and needs to not be triggerable by
# a stranger who finds the URL. Point an external scheduler (a Railway Cron
# Job, or a free pinger like https://cron-job.org) at
# https://cornwallradar.co.uk/api/cron/morning-digest?secret=<this value>
# roughly once an hour.
CRON_SECRET=
