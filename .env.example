# Copy this file to .env and fill in your own values.
# Nothing in this project will run against real traffic/bus data without these.

PORT=3000

# TomTom Traffic API — free tier signup: https://developer.tomtom.com/
TOMTOM_API_KEY=

# Bus Open Data Service (BODS) — free registration: https://data.bus-data.dft.gov.uk/
BODS_API_KEY=

# National Highways Roads API (trunk road closures) — free registration:
# https://developer.nationalhighways.co.uk/ — optional, adds A30/A38/A39/A390
# closures alongside TomTom's incidents. Traffic still works with just TomTom.
NATIONAL_HIGHWAYS_API_KEY=

# Filled in once Phase 1.5 (auth/billing/alerts) is built:
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
